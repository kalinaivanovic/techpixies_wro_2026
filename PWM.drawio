  <diagram id="8T93kQ0huurQV7kjdKBH" name="Detekcija znakova">
    <mxGraphModel dx="2033" dy="1126" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4681" pageHeight="11811" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="jmMv5IX9MfPXwL6D6muV-1" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=19;" value="To su zapravo dva algoritma koji rade zajedno:                                                                                                                &#xa;                                                                                                                                                                             &#xa;  1. LIDAR klasterovanje — pronalazi male objekte (zna poziciju i veličinu, ali ne i boju)                                                                                   &#xa;  2. Kamera detekcija boje — pronalazi obojene mrlje (zna boju, ali ne i rastojanje)                                                                                         &#xa;  3. Uparivanje stubova — spaja ih: &quot;mali objekat na 25° je ista stvar kao crvena mrlja na 25° → to je CRVENI stub na 310mm&quot;                                                 &#xa;                                                                                                                                                                             &#xa;  Korak 1: LIDAR pronalazi &quot;nešto malo&quot;                                                                                                                                    &#xa;&#xa;  Algoritam klasterovanja (isti koji koristi detekcija zidova) klasifikuje svaki objekat po širini:" vertex="1">
          <mxGeometry height="250" width="1280" x="150" y="70" as="geometry" />
        </mxCell>
        <mxCell id="Bkb0WXUjInYzl04eEmOD-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="20" width="1140" x="152.5" y="310" as="geometry" />
        </mxCell>
        <mxCell id="Bkb0WXUjInYzl04eEmOD-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;rotation=-90;" value="" vertex="1">
          <mxGeometry height="20" width="785" x="-230" y="712.5" as="geometry" />
        </mxCell>
        <mxCell id="Bkb0WXUjInYzl04eEmOD-3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;rotation=-90;" value="" vertex="1">
          <mxGeometry height="20" width="525" x="335" y="842.5" as="geometry" />
        </mxCell>
        <mxCell id="Bkb0WXUjInYzl04eEmOD-4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="20" width="690" x="607.5" y="590" as="geometry" />
        </mxCell>
        <mxCell id="Bkb0WXUjInYzl04eEmOD-5" edge="1" parent="1" source="Bkb0WXUjInYzl04eEmOD-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="582.5" y="940" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Bkb0WXUjInYzl04eEmOD-6" connectable="0" parent="Bkb0WXUjInYzl04eEmOD-5" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="480mm" vertex="1">
          <mxGeometry relative="1" x="0.0171" y="2" as="geometry">
            <mxPoint x="-14" y="-8" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Bkb0WXUjInYzl04eEmOD-9" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" value="" vertex="1">
          <mxGeometry height="80" width="80" x="272.5" y="900" as="geometry" />
        </mxCell>
        <mxCell id="Bkb0WXUjInYzl04eEmOD-10" edge="1" parent="1" source="Bkb0WXUjInYzl04eEmOD-9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.222;entryY=0.973;entryDx=0;entryDy=0;entryPerimeter=0;" target="Bkb0WXUjInYzl04eEmOD-2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Bkb0WXUjInYzl04eEmOD-11" connectable="0" parent="Bkb0WXUjInYzl04eEmOD-10" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="350mm" vertex="1">
          <mxGeometry relative="1" x="-0.2063" y="-1" as="geometry">
            <mxPoint x="-3" y="-9" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Bkb0WXUjInYzl04eEmOD-13" parent="1" style="text;whiteSpace=wrap;fontSize=19;" value="Klasifikacija po širini:&#xa;65mm &lt; 120mm  →  &quot;stub&quot; (ne &quot;zid&quot;)&#xa;&#xa;&#xa;LIDAR zna: postoji mali objekat na uglu 25°, rastojanje 310mm, širina 65mm. Ali nema pojma koje je boje. Može biti crveni, zeleni, ili čak nasumična prepreka." vertex="1">
          <mxGeometry height="307.5" width="760" x="620" y="622.5" as="geometry" />
        </mxCell>
        <mxCell id="Bkb0WXUjInYzl04eEmOD-14" parent="1" style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FF1450;" value="" vertex="1">
          <mxGeometry height="17.5" width="17.5" x="280" y="790" as="geometry" />
        </mxCell>
        <mxCell id="Bkb0WXUjInYzl04eEmOD-16" edge="1" parent="1" source="Bkb0WXUjInYzl04eEmOD-15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="Bkb0WXUjInYzl04eEmOD-14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="Bkb0WXUjInYzl04eEmOD-15" parent="1" style="text;whiteSpace=wrap;" value="Mali objekat sirine 25mm, na 25 stepeni, daljina 310mm" vertex="1">
          <mxGeometry height="41.25" width="155" x="335" y="778.75" as="geometry" />
        </mxCell>
        <mxCell id="Bkb0WXUjInYzl04eEmOD-17" parent="1" style="text;whiteSpace=wrap;fontSize=19;" value="Korak 2: Kamera pronalazi &quot;nešto crveno&quot;&#xa;&#xa;Kamera detektuje obojene regione u slici koristeći HSV filtriranje boja:&#xa;Kamera vidi (640×480 piksela):" vertex="1">
          <mxGeometry height="100" width="1080" x="140" y="1180" as="geometry" />
        </mxCell>
        <mxCell id="Bkb0WXUjInYzl04eEmOD-18" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="210" width="600" x="160" y="1320" as="geometry" />
        </mxCell>
        <mxCell id="Bkb0WXUjInYzl04eEmOD-19" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FF1450;" value="" vertex="1">
          <mxGeometry height="80" width="40" x="268.75" y="1385" as="geometry" />
        </mxCell>
        <mxCell id="Bkb0WXUjInYzl04eEmOD-20" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="crvena mrlja&amp;nbsp;na x=387, y=210,&amp;nbsp;širina=32, vis.=55,&amp;nbsp;površina=1430 px" vertex="1">
          <mxGeometry height="50" width="170" x="360" y="1390" as="geometry" />
        </mxCell>
        <mxCell id="Bkb0WXUjInYzl04eEmOD-21" parent="1" style="text;whiteSpace=wrap;html=1;" value="&amp;nbsp;-60°&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; -30°&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; 0°&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;+25°&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;+60°" vertex="1">
          <mxGeometry height="40" width="560" x="180" y="1530" as="geometry" />
        </mxCell>
        <mxCell id="Bkb0WXUjInYzl04eEmOD-22" parent="1" style="text;whiteSpace=wrap;fontSize=19;" value="Piksel x=387 → ugao = +25.2°&#xa;&#xa;&#xa;Kamera zna: postoji crvena mrlja na uglu 25.2°. Ali nema pojma koliko je daleko." vertex="1">
          <mxGeometry height="120" width="707.5" x="152.5" y="1570" as="geometry" />
        </mxCell>
        <mxCell id="Bkb0WXUjInYzl04eEmOD-23" parent="1" style="text;whiteSpace=wrap;html=1;fontSize=19;" value="Korak 3: Uparivanje — fuzija&lt;br&gt;&lt;br&gt;  Sada dolazi ključni korak. Imamo dvije liste:&lt;br&gt;&lt;br&gt;  LIDAR objekti: &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp;Kamera mrlje:&lt;br&gt;  ┌──────────────────────────┐       ┌──────────────────────────┐&lt;br&gt;  │ objekat na 270°, 380mm&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;│       │ crvena mrlja na 25.2° &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; │&lt;br&gt;  │ objekat na 88°,  450mm&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;│       │&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;│&lt;br&gt;  │ objekat na 0°,  2100mm&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;│       │&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;│&lt;br&gt;  │ objekat na 25.5°, 310mm&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; │       │&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;│&lt;br&gt;  └──────────────────────────┘       └──────────────────────────┘&lt;br&gt;&lt;br&gt;  Za svaku obojenu mrlju, pronađi LIDAR objekat sa najbližim uglom:&lt;br&gt;&lt;br&gt;  Crvena mrlja na 25.2°:&lt;br&gt;&lt;br&gt;    objekat na 270° → razlika = |25.2 - (-90)| = 115°  ✗ predaleko&lt;br&gt;    objekat na 88°  → razlika = |25.2 - 88|    = 63°   ✗ predaleko&lt;br&gt;    objekat na 0°   → razlika = |25.2 - 0|     = 25°   ✗ predaleko&lt;br&gt;    objekat na 25.5°→ razlika = |25.2 - 25.5|  = 0.3°  ✓ POKLAPANJE!&lt;br&gt;&lt;br&gt;  Poklapanje pronađeno! Spajamo ih:&lt;br&gt;&lt;br&gt;    Boja:       &quot;red&quot;   ← od kamere&lt;br&gt;    Ugao:       25.2°   ← od kamere&lt;br&gt;    Rastojanje: 310mm   ← od LIDAR-a&lt;br&gt;&lt;br&gt;    → Pillar(color=&quot;red&quot;, angle=25.2, distance=310.0)&lt;br&gt;    → pass_side = &quot;right&quot; (crveni = zaobiđi sa desne strane)&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;b&gt;Šta se dešava bez poklapanja&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Kamera vidi crveno, ali nema LIDAR objekta u blizini — ignoriše se. Može biti crvena majica sudije u publici, crveni telefon&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;na stolu, itd. Bez LIDAR potvrde to nije stub.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;LIDAR vidi mali objekat, ali nema obojene mrlje — ostaje kao generički objekat tipa &quot;stub&quot; u klasterovanju, ali ne postaje&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;potvrđeni Pillar u WorldState. Može biti flašica vode koju je neko ostavio na stazi, nosač na zidu, itd.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Oba senzora moraju da se slože — to je cijela poenta fuzije. Jedan senzor sam može biti prevaren, ali oba koji vide istu&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;stvar na istom uglu je veoma pouzdano.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="940" width="1030" x="140" y="1700" as="geometry" />
        </mxCell>
        <mxCell id="Bkb0WXUjInYzl04eEmOD-24" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="887" width="1493" x="1370" y="270" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="EsS5gbu6UkMku1FPydMP" name="Izbjegavanje znakova/stubova">
    <mxGraphModel dx="925" dy="1416" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4681" pageHeight="11811" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="MYfSe4ynjweEpHBIqQOS-2" parent="1" style="text;whiteSpace=wrap;fontSize=19;" value="Zaobilaženje stubova — Kako robot zaobilazi crvene i zelene stubove" vertex="1">
          <mxGeometry height="40" width="630" x="110" y="60" as="geometry" />
        </mxCell>
        <mxCell id="MYfSe4ynjweEpHBIqQOS-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=19;" value="Kad detekcija stubova pronađe potvrđeni stub ispred robota, automat prelazi iz WALL_FOLLOW u AVOID_PILLAR. Ovaj algoritam računa koliko jako skrenuti i u kom pravcu." vertex="1">
          <mxGeometry height="50" width="1030" x="110" y="120" as="geometry" />
        </mxCell>
        <mxCell id="MYfSe4ynjweEpHBIqQOS-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=19;fontStyle=1" value="&lt;div&gt;&amp;nbsp; WRO pravilo&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; CRVENI stub&amp;nbsp; → zaobiđi sa DESNE strane → skreni DESNO (da ga zaobiđeš)&lt;/div&gt;&lt;div&gt;&amp;nbsp; ZELENI stub&amp;nbsp; → zaobiđi sa LIJEVE strane → skreni LIJEVO (da ga zaobiđeš&lt;/div&gt;" vertex="1">
          <mxGeometry height="110" width="1020" x="110" y="190" as="geometry" />
        </mxCell>
        <mxCell id="MYfSe4ynjweEpHBIqQOS-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=19;" value="&lt;div&gt;Osnovna ideja&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; Dva faktora određuju koliko jako skrenuti:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; 1. Rastojanje — bliži stub = oštrije skretanje (hitnije je)&lt;/div&gt;&lt;div&gt;&amp;nbsp; 2. Ugao — stub koji je više ispred = oštrije skretanje (više smeta)&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="720" x="110" y="310" as="geometry" />
        </mxCell>
        <mxCell id="PfNXfC1yOFS2jWvfNDxl-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="370" width="30" x="130" y="590" as="geometry" />
        </mxCell>
        <mxCell id="PfNXfC1yOFS2jWvfNDxl-2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="370" width="30" x="620" y="590" as="geometry" />
        </mxCell>
        <mxCell id="PfNXfC1yOFS2jWvfNDxl-7" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" value="" vertex="1">
          <mxGeometry height="80" width="80" x="350" y="830" as="geometry" />
        </mxCell>
        <mxCell id="PfNXfC1yOFS2jWvfNDxl-8" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=19;" value="Lijevi zid" vertex="1">
          <mxGeometry height="30" width="90" x="100" y="970" as="geometry" />
        </mxCell>
        <mxCell id="PfNXfC1yOFS2jWvfNDxl-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=19;" value="Desni zid" vertex="1">
          <mxGeometry height="30" width="90" x="590" y="970" as="geometry" />
        </mxCell>
        <mxCell id="PfNXfC1yOFS2jWvfNDxl-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=19;" value="Situacija A: stub je deleko (700mm) -&amp;gt; blago skretanje" vertex="1">
          <mxGeometry height="30" width="570" x="120" y="530" as="geometry" />
        </mxCell>
        <mxCell id="PfNXfC1yOFS2jWvfNDxl-11" parent="1" style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e51400;fontColor=#ffffff;strokeColor=#B20000;" value="" vertex="1">
          <mxGeometry height="30" width="30" x="310" y="670" as="geometry" />
        </mxCell>
        <mxCell id="PfNXfC1yOFS2jWvfNDxl-12" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Crveni stub, 700mm daleko" vertex="1">
          <mxGeometry height="30" width="130" x="350" y="670" as="geometry" />
        </mxCell>
        <mxCell id="PfNXfC1yOFS2jWvfNDxl-14" edge="1" parent="1" source="PfNXfC1yOFS2jWvfNDxl-13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="PfNXfC1yOFS2jWvfNDxl-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PfNXfC1yOFS2jWvfNDxl-13" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="blago lijevo" vertex="1">
          <mxGeometry height="30" width="90" x="480" y="855" as="geometry" />
        </mxCell>
        <mxCell id="PfNXfC1yOFS2jWvfNDxl-15" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=19;" value="Hitnost niska → mali otklon → upravljanje = 75° (blago lijevo)" vertex="1">
          <mxGeometry height="30" width="550" x="120" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="PfNXfC1yOFS2jWvfNDxl-16" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="370" width="30" x="950" y="590" as="geometry" />
        </mxCell>
        <mxCell id="PfNXfC1yOFS2jWvfNDxl-17" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="370" width="30" x="1440" y="590" as="geometry" />
        </mxCell>
        <mxCell id="PfNXfC1yOFS2jWvfNDxl-18" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" value="" vertex="1">
          <mxGeometry height="80" width="80" x="1170" y="830" as="geometry" />
        </mxCell>
        <mxCell id="PfNXfC1yOFS2jWvfNDxl-19" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=19;" value="Lijevi zid" vertex="1">
          <mxGeometry height="30" width="90" x="920" y="970" as="geometry" />
        </mxCell>
        <mxCell id="PfNXfC1yOFS2jWvfNDxl-20" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=19;" value="Desni zid" vertex="1">
          <mxGeometry height="30" width="90" x="1410" y="970" as="geometry" />
        </mxCell>
        <mxCell id="PfNXfC1yOFS2jWvfNDxl-21" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=19;" value="Situacija A: stub je deleko (700mm) -&amp;gt; blago skretanje" vertex="1">
          <mxGeometry height="30" width="570" x="940" y="530" as="geometry" />
        </mxCell>
        <mxCell id="PfNXfC1yOFS2jWvfNDxl-22" parent="1" style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#e51400;fontColor=#ffffff;strokeColor=#B20000;" value="" vertex="1">
          <mxGeometry height="30" width="30" x="1180" y="750" as="geometry" />
        </mxCell>
        <mxCell id="PfNXfC1yOFS2jWvfNDxl-23" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="Crveni stub, 200mm daleko" vertex="1">
          <mxGeometry height="30" width="130" x="1230" y="750" as="geometry" />
        </mxCell>
        <mxCell id="PfNXfC1yOFS2jWvfNDxl-24" edge="1" parent="1" source="PfNXfC1yOFS2jWvfNDxl-25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" target="PfNXfC1yOFS2jWvfNDxl-18">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="PfNXfC1yOFS2jWvfNDxl-25" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="oštro lijevo" vertex="1">
          <mxGeometry height="30" width="90" x="1300" y="855" as="geometry" />
        </mxCell>
        <mxCell id="PfNXfC1yOFS2jWvfNDxl-26" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontSize=19;" value="Hitnost visoka → veliki otklon → upravljanje = 10° (oštro lijevo)" vertex="1">
          <mxGeometry height="30" width="550" x="940" y="1020" as="geometry" />
        </mxCell>
        <mxCell id="PfNXfC1yOFS2jWvfNDxl-29" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=19;" value="&lt;div&gt;&amp;nbsp; Kako se računa otklon upravljanja&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; 1. Bazni otklon iz hitnosti:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;base_offset = min_steer_offset + urgency × (max_steer_offset - min_steer_offset)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;Primjer (urgency = 0.87):&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;base_offset = 45 + 0.87 × (80 - 45) = 45 + 30 = 75°&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; 2. Korekcija ugla:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;Ako je stub više na strani u koju skrenemo → treba još jače skrenuti.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;Crveni stub na uglu +15° (desno od centra):&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;pravac = -1 (skreni lijevo jer je crveni)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;korekcija = pravac × ugao × angle_gain&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;korekcija = -1 × 15 × 0.8 = -12°&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;Negativna korekcija = stub je desno, a mi skrenemo desno&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;→ smanjuje offset (stub nije baš ispred, manje hitno)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;Crveni stub na uglu -10° (lijevo od centra):&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;korekcija = -1 × (-10) × 0.8 = +8°&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;Pozitivna korekcija = stub je na istoj strani kuda skrenemo&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;→ povećava offset (stub nam je na putu, treba jače!)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; 3. Konačni otklon:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;offset = base_offset + korekcija&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;offset = max(min_steer_offset, min(max_steer_offset, offset))&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; 4. Upravljanje:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;upravljanje = steering_center + (pravac × offset)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;upravljanje = 90 + (-1 × 75) = 15°&amp;nbsp; &amp;nbsp;(oštro lijevo)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; Kompletni primjer: Crveni stub na 25°, 310mm&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; 1. Pravac:&amp;nbsp; crveni → -1 (skreni lijevo)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; 2. Hitnost:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;linear&amp;nbsp; = 1.0 - (310/800) = 0.6125&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;urgency = 0.6125 ^ 0.5&amp;nbsp; &amp;nbsp; = 0.78&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; 3. Bazni otklon:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;base_offset = 45 + 0.78 × (80 - 45) = 45 + 27 = 72°&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; 4. Korekcija ugla:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;korekcija = -1 × 25 × 0.8 = -20&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;(stub je desno, mi skrenemo lijevo → manje hitno)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; 5. Konačni otklon:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;offset = 72 + (-20) = 52°&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;offset = max(45, min(80, 52)) = 52°&amp;nbsp; &amp;nbsp;(unutar granica)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; 6. Upravljanje:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;upravljanje = 90 + (-1 × 52) = 38°&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; Rezultat: brzina=35, upravljanje=38° (skretanje lijevo)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; Kad završava zaobilaženje?&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; Mašina stanja prati stub i odlučuje kad je bezbjedno preći nazad na praćenje zidova:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; 1. Minimalni broj frejmova (25 frejmova ≈ 0.5 sekundi)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;→ Ne prekidaj manevar prerano, čak i ako stub nestane na trenutak&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; 2. Stub je prošao? Tri uslova (bilo koji):&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Stub potpuno nestao iz vida duže od 50 frejmova&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Stub je daleko sa strane (ugao &amp;gt; 65° od centra)&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;- Stub je dovoljno daleko (&amp;gt; 600mm)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; Sve dok stub nije prošao → nastavi skretati&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; Kad prođe → nazad na WALL_FOLLOW&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; Šta ako stub nestane iz vida usred manevra?&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; Kamera ga više ne vidi (npr. prošao je ispod vidnog polja kamere). Robot ne smije prestati skretati — stub je još tu, samo ga ne vidi!&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; Stub nestao, ali manevar nije završen:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; → nastavi skretati u istom pravcu sa max_steer_offset&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; → drži kurs dok ne prođe dovoljno frejmova&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; Ovo spriječava: &quot;vidim stub → skreni lijevo → ne vidim → ispravi se → vidim opet → skreni → ...&quot;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="1890" width="620" x="1340" y="1470" as="geometry" />
        </mxCell>
        <mxCell id="yreTPQJanc2KpSruYsrd-1" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="124" width="548" x="940" y="1130" as="geometry" />
        </mxCell>
        <mxCell id="yreTPQJanc2KpSruYsrd-2" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="1073" width="1361" x="1740" y="270" as="geometry" />
        </mxCell>
        <UserObject label="Od ovih, slow_speed, min_steer_offset i max_steer_offset su podesivi u toku rada iz params.json." link="Od ovih, slow_speed, min_steer_offset i max_steer_offset su podesivi u toku rada iz params.json." id="yreTPQJanc2KpSruYsrd-3">
          <mxCell parent="1" style="text;whiteSpace=wrap;fontSize=20;" vertex="1">
            <mxGeometry height="40" width="1270" x="1760" y="1370" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="2IeoT66P98BCcQJRsr25-2" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=16;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Opis algoritma&lt;/h1&gt;&lt;p&gt;Robot koristi dva senzora zajedno:&lt;/p&gt;&lt;p&gt;&amp;nbsp; 1. &lt;b&gt;Kamera&lt;/b&gt; vidi boju — crvena ili zelena&lt;/p&gt;&lt;p&gt;&amp;nbsp; 2. &lt;b&gt;LIDAR&lt;/b&gt; mjeri tačno rastojanje u milimetrima&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;SensorFusion spaja ova dva podatka po uglu: &quot;crveni blob na 30°&quot; + &quot;objekat na 30°, rastojanje 400mm&quot; = potvrđen crveni stub&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;na 400mm.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Pravilo zaobilaženja&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Prema WRO pravilima:&lt;/span&gt;&lt;/p&gt;&lt;p&gt;- &lt;b&gt;Crveni stub&lt;/b&gt; → robot prolazi sa desne strane stuba (skreće desno da zaobiđe)&lt;/p&gt;&lt;p&gt;- &lt;b&gt;Zeleni stub&lt;/b&gt; → robot prolazi sa lijeve strane stuba (skreće lijevo da zaobiđe)&lt;/p&gt;&lt;div&gt;&lt;div&gt;&lt;b&gt;&lt;font style=&quot;font-size: 20px;&quot;&gt;Kako algoritam radi&lt;/font&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Kada je stub potvrđen, robot mora da izračuna koliko jako da skrene. To zavisi od dva faktora:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;1. Rastojanje (hitnost)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; Što je stub bliži, to robot mora jače da skrene. Koristi se kriva &lt;b&gt;&lt;i&gt;kvadratnog korijena&lt;/i&gt;&lt;/b&gt;:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; linear = 1 - (rastojanje / max_rastojanje)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; urgency = √linear&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; Primjer sa max_rastojanje = 1000mm:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; Stub na 800mm:&amp;nbsp; linear = 0.2&amp;nbsp; →&amp;nbsp; urgency = √0.2 = 0.45&lt;/div&gt;&lt;div&gt;&amp;nbsp; Stub na 500mm:&amp;nbsp; linear = 0.5&amp;nbsp; →&amp;nbsp; urgency = √0.5 = 0.71&lt;/div&gt;&lt;div&gt;&amp;nbsp; Stub na 200mm:&amp;nbsp; linear = 0.8&amp;nbsp; →&amp;nbsp; urgency = √0.8 = 0.89&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; Zašto kvadratni korijen? Linearna funkcija bi reagovala presporo na srednjim rastojanjima. Kvadratni korijen daje jaču&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;reakciju ranije, dok robot još ima prostora za manevar.&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;b&gt;2. Ugao stuba&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; Robot također uzima u obzir pod kojim uglom vidi stub. Stub koji je pravo ispred (0°) zahtijeva jaču reakciju od stuba koji&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;je već sa strane (30°).&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;Izračunavanje skretanja&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; skretanje = urgency × max_skretanje × smjer&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; smjer:&amp;nbsp; -1 za lijevo (crveni stub)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;+1 za desno (zeleni stub)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; Primjer: crveni stub na 500mm, pravo ispred&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;urgency&amp;nbsp; &amp;nbsp;= 0.71&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;skretanje = 0.71 × 30° × (-1) = -21.3°&amp;nbsp; (skreće lijevo)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;div&gt;&lt;b&gt;Kontrola brzine&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; Robot usporava kada vidi stub:&lt;/div&gt;&lt;div&gt;&amp;nbsp; brzina = normal_speed × (1 - urgency × faktor_usporenja)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; Na velikom rastojanju — vozi skoro normalnom brzinom. Kad se približi — usporava značajno da ima vremena za manevar.&lt;/div&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="1520" width="830" x="120" y="1120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="Syr6wQzV1JI0kWZHscff" name="Page-13">
    <mxGraphModel dx="813" dy="450" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4681" pageHeight="11811" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="oc9nEOmwr8DruUyNuM0a-4" edge="1" parent="1" source="wEV2np7X-F0_-IM10HS9-1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" target="oc9nEOmwr8DruUyNuM0a-3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wEV2np7X-F0_-IM10HS9-1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;" value="Kontroler" vertex="1">
