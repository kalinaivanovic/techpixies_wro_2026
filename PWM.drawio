        <mxCell id="436JC0CrdJWV8KaeyKvG-42" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=19;" value="Računanje upravljanja:&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;1. IZMJERI:&amp;nbsp; lijevo = 200mm,&amp;nbsp; desno = 600mm&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;2. IZRAČUNAJ CILJ:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;koridor = lijevo + desno = 800mm&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;cilj = koridor / 2 = 400mm&amp;nbsp; &amp;nbsp; &amp;nbsp;(centar hodnika)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;3. IZRAČUNAJ GREŠKU:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;greška = desno - cilj = 600 - 400 = +200mm&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;(pozitivno = previše prostora desno = robot je lijevo = treba skrenuti desno)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;4. PRIMIJENI POJAČANJE (Kp):&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;upravljanje = 90 + Kp × greška&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;upravljanje = 90 + 0.5 × 200&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;upravljanje = 90 + 100 = 190°&amp;nbsp; &amp;nbsp; ← ali ovo je previše!&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;5. OGRANIČI:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;upravljanje = max(60, min(120, 190))&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;upravljanje = 120°&amp;nbsp; &amp;nbsp;(maksimalno desno, ali ne više)&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;Šta je Kp (proporcionalno pojačanje)?&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Kp kontroliše koliko agresivno robot reaguje na grešku:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; Kp = 0.1 (blago):&amp;nbsp; &amp;nbsp;greška 200mm → korekcija samo 20° → sporo centriranje&lt;/div&gt;&lt;div&gt;&amp;nbsp; Kp = 0.5 (umjereno): greška 200mm → korekcija 100° → osrednje&lt;/div&gt;&lt;div&gt;&amp;nbsp; Kp = 1.0 (agresivno): greška 200mm → korekcija 200° → brzo ali ljuljanje&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; Premalo Kp:&amp;nbsp; robot sporo reaguje, udari u zid na krivini&lt;/div&gt;&lt;div&gt;&amp;nbsp; Previše Kp:&amp;nbsp; robot se ljulja lijevo-desno (osciluje)&lt;/div&gt;&lt;div&gt;&amp;nbsp; Dobro Kp:&amp;nbsp; &amp;nbsp; robot glatko klizi ka centru&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&amp;nbsp; Specijalni slučajevi&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; Samo jedan zid je vidljiv (npr. pri izlasku iz ćoška):&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; Samo desni zid vidljiv (lijevi = None):&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; greška = desno - min_clearance = 450 - 150 = 300&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; → upravljaj na osnovu rastojanja od jednog zida&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; → cilj je ostati bar 150mm od zida (min_clearance)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; Samo lijevi zid vidljiv (desni = None):&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; greška = min_clearance - lijevo = 150 - 200 = -50&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; → blaga korekcija lijevo&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; Nijedan zid nije vidljiv (ne bi trebalo da se desi na stazi):&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; lijevo = None, desno = None:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; → vozi pravo (upravljanje = 90°, brzina = normalna)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; Adaptivno centriranje&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; Hodnik može biti širok (1000mm) ili uzak (600mm) — mijenja se po sekcijama na WRO stazi. Algoritam se automatski prilagođava&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;jer uvijek cilja na centar izmjerenog koridora:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; Širok hodnik (1000mm):&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; cilj = 1000 / 2 = 500mm od svakog zida&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; Uzak hodnik (600mm):&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; cilj = 600 / 2 = 300mm od svakog zida&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; Robot ne mora znati unaprijed koliko je hodnik širok.&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; Mjeri oba zida, dijeli na pola, gotovo.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; Ali postoji minimalni razmak (min_clearance = 150mm). U uskom hodniku od 600mm, robot neće ciljati na 100mm od zida — cilj&lt;/div&gt;&lt;div&gt;&amp;nbsp; se ograničava na bar 150mm.&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="1540" width="1700" x="120" y="960" as="geometry" />
        </mxCell>
        <mxCell id="436JC0CrdJWV8KaeyKvG-43" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="863" width="1517" x="2360" y="260" as="geometry" />
