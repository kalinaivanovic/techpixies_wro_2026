        <mxCell id="UUJ-8YNv2WkAIoh8uLEk-10" connectable="0" parent="UUJ-8YNv2WkAIoh8uLEk-9" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="400mm" vertex="1">
