        <mxCell id="UUJ-8YNv2WkAIoh8uLEk-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=16;" value="Prvo se vrsi detekcija objekata, pa se zatim koriste detektovani zidovi" vertex="1">
          <mxGeometry height="120" width="510.7" x="379.3" y="1650" as="geometry" />
        </mxCell>
        <mxCell id="UUJ-8YNv2WkAIoh8uLEk-11" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="&lt;div&gt;&amp;nbsp; AverageWallDetection usrednjava sve unutar 80°-100°:&lt;/div&gt;&lt;div&gt;&amp;nbsp; očitavanja: 448, 452, 455, 300, 305, 310, 449, 451, 447, ...&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ^^^&amp;nbsp; ^^^&amp;nbsp; ^^^&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;Umiješana očitavanja stuba!!!&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; average = ~400mm&amp;nbsp; &amp;nbsp;← POGREŠNO (ZID JE NA 450mm)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; Robot misli da je zid bliže nego što jeste u stvari. Upravljanje se bazira na pogrešnom broju.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="147.61" width="490.3" x="847.88" y="1807.92" as="geometry" />
        </mxCell>
        <mxCell id="UUJ-8YNv2WkAIoh8uLEk-12" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="&lt;div&gt;&amp;nbsp; ClusteringWallDetection prvo identifikuje objekte, pa na osnovu toga ignoriše stub:&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; Korak 1: Klasterovanje pronalazi dva objekta na 90°:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; - Objekat A: ugao=90°, daljina=300mm, širina=65mm&amp;nbsp; &amp;nbsp;→ &quot;stub&quot; (&amp;lt; 120mm)&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; - Objekat B: ugao=88°, daljina=450mm, širina=1600mm → &quot;zid&quot;&amp;nbsp; &amp;nbsp;(&amp;gt; 120mm)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; Korak 2: Filtriranje — samo zidovi:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; - Objekat B: &quot;zid&quot;&amp;nbsp; na 450mm&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; Korak 3: Nađi zid na oko 90°:&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; - Objekat B na 88° → diff = |88 - 90| = 2° → unutar 45° tolerancije&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; - right_distance = 450mm&amp;nbsp; &amp;nbsp;← TAČNO&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="220.65" width="475.14" x="844.86" y="1999.35" as="geometry" />
        </mxCell>
        <mxCell id="UUJ-8YNv2WkAIoh8uLEk-19" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
