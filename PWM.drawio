        <mxCell id="2E0lpal7M5NjtUQ1HJ6w-88" parent="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;" value="" vertex="1">
          <mxGeometry height="80" width="80" x="518.5499999999998" y="2062.0800000000004" as="geometry" />
