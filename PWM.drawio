        <mxCell id="EPm4XhIY2Ruw9Mwyadko-50" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=19;" value="&lt;div&gt;Očitavanje naprijed je veliko (2000mm). Lijevo i desno su umjerena (380mm, 450mm). Sve je normalno — nastavlja praćenje zida.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
