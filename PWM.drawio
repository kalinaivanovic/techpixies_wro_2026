        <mxCell id="EPm4XhIY2Ruw9Mwyadko-51" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=19;fontStyle=1" value="Algoritam za detektovanje skretanja" vertex="1">
          <mxGeometry height="100" width="450" x="242.5" y="130" as="geometry" />
        </mxCell>
        <mxCell id="EPm4XhIY2Ruw9Mwyadko-52" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
